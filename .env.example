DATABASE_URL=                 # Railway: ${{Postgres.DATABASE_URL}}
JWT_SECRET=                   # long random string (also derives the key that encrypts stored secrets)
APP_URL=https://deerager.com  # public URL: used in emails, Stripe redirects and webhooks
ADMIN_EMAIL=                  # seeds the first admin; remove ADMIN_PASSWORD after first login
ADMIN_PASSWORD=
S3_ENDPOINT=                  # Railway bucket variables
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_VHOST=true                 # Railway buckets use virtual-host URLs
ANTHROPIC_API_KEY=
MODEL_CLAUDE=                 # exact model ids, so they never go stale
OPENAI_API_KEY=
MODEL_OPENAI=
GEMINI_API_KEY=
MODEL_GEMINI=
STRIPE_PUBLISHABLE_KEY=       # seeds the DB on first start; Stripe secret/webhook/Resend keys are entered in Admin > Settings
